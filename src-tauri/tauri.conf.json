{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MoveWallpapers",
  "version": "0.1.0",
  "identifier": "com.movewallpapers.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Move Wallpapers",
        "width": 920,
        "height": 720,
        "resizable": true,
        "visible": true,
        "backgroundColor": "#1a1a1a"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
